From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Exit the Moat <no-reply@exit-the-moat.com>
Date: Tue, 17 Nov 2026 18:08:01 +0100
Subject: [PATCH] ep4 (wan1): lazy torch weights for the Wan experts (bf16,
 only when the TT cache is missing) and umT5; first 1x2 clip runs (480p 661 s)

---
 .../transformers/wan2_2/transformer_wan.py    | 32 +++++++++++------
 models/tt_dit/pipelines/wan/text_encoder.py   | 36 ++++++++++++-------
 2 files changed, 45 insertions(+), 23 deletions(-)

diff --git a/models/tt_dit/models/transformers/wan2_2/transformer_wan.py b/models/tt_dit/models/transformers/wan2_2/transformer_wan.py
index 8668c15ec596..501b8308324e 100644
--- a/models/tt_dit/models/transformers/wan2_2/transformer_wan.py
+++ b/models/tt_dit/models/transformers/wan2_2/transformer_wan.py
@@ -708,21 +708,32 @@ class WanCheckpoint:
     def __init__(self, name: str, subfolder: str) -> None:
         self._name = name
         self._subfolder = subfolder
-        torch_transformer = TorchWanTransformer3DModel.from_pretrained(
-            name,
-            subfolder=subfolder,
-            trust_remote_code=True,
-        )
-        torch_transformer.eval()
-        self._config = torch_transformer.config
-        self._state_dict = torch_transformer.state_dict()
+        # ep4: config only; the torch weights load lazily (only when the TT cache is missing), in bf16
+        # unless EP4_TORCH_FP32=1, and are released right after the cache is written.
+        self._config = TorchWanTransformer3DModel.load_config(name, subfolder=subfolder)
+        self._config = type("Cfg", (), dict(self._config))
+        self._state_dict = None
+
+    def _load_state_dict(self) -> dict[str, torch.Tensor]:
+        if self._state_dict is None:
+            dt = torch.float32 if os.environ.get("EP4_TORCH_FP32") == "1" else torch.bfloat16
+            logger.info(f"ep4: loading torch weights {self._name}/{self._subfolder} as {dt}")
+            torch_transformer = TorchWanTransformer3DModel.from_pretrained(
+                self._name, subfolder=self._subfolder, trust_remote_code=True, torch_dtype=dt
+            )
+            torch_transformer.eval()
+            self._state_dict = torch_transformer.state_dict()
+        return self._state_dict
+
+    def release_torch(self) -> None:
+        self._state_dict = None
 
     @property
     def subfolder(self) -> str:
         return self._subfolder
 
     def state_dict(self) -> dict[str, torch.Tensor]:
-        return dict(self._state_dict)
+        return dict(self._load_state_dict())
 
     def build(
         self,
@@ -769,7 +780,7 @@ class WanCheckpoint:
         """Load (or reload) weights for a previously-built transformer."""
         cache.load_model(
             tt_model=model,
-            get_torch_state_dict=lambda: self._state_dict,
+            get_torch_state_dict=self._load_state_dict,
             model_name=os.path.basename(self._name),
             subfolder=self._subfolder,
             parallel_config=parallel_config,
@@ -777,3 +788,4 @@ class WanCheckpoint:
             mesh_device=mesh_device,
             is_fsdp=is_fsdp,
         )
+        self.release_torch()
diff --git a/models/tt_dit/pipelines/wan/text_encoder.py b/models/tt_dit/pipelines/wan/text_encoder.py
index c3a4008a8545..8b04cef28431 100644
--- a/models/tt_dit/pipelines/wan/text_encoder.py
+++ b/models/tt_dit/pipelines/wan/text_encoder.py
@@ -57,21 +57,23 @@ class TextEncoder:
         self._max_sequence_length = max_sequence_length
 
         self._tokenizer = AutoTokenizer.from_pretrained(checkpoint_name, subfolder="tokenizer", trust_remote_code=True)
-        self._torch_text_encoder = UMT5EncoderModel.from_pretrained(
-            checkpoint_name, subfolder="text_encoder", trust_remote_code=True
-        )
+        # ep4: the torch umT5 (fp32 on disk, 22.7 GB) loads lazily, only when the TT cache is missing.
+        from transformers import AutoConfig
+
+        tcfg = AutoConfig.from_pretrained(checkpoint_name, subfolder="text_encoder", trust_remote_code=True)
+        self._torch_text_encoder = None
 
         umt5_config = UMT5Config(
-            vocab_size=self._torch_text_encoder.config.vocab_size,
-            embed_dim=self._torch_text_encoder.config.d_model,
-            ff_dim=self._torch_text_encoder.config.d_ff,
-            kv_dim=self._torch_text_encoder.config.d_kv,
-            num_heads=self._torch_text_encoder.config.num_heads,
-            num_hidden_layers=self._torch_text_encoder.config.num_layers,
+            vocab_size=tcfg.vocab_size,
+            embed_dim=tcfg.d_model,
+            ff_dim=tcfg.d_ff,
+            kv_dim=tcfg.d_kv,
+            num_heads=tcfg.num_heads,
+            num_hidden_layers=tcfg.num_layers,
             max_prompt_length=512,  # TODO: Consider removing
-            layer_norm_eps=self._torch_text_encoder.config.layer_norm_epsilon,
-            relative_attention_num_buckets=self._torch_text_encoder.config.relative_attention_num_buckets,
-            relative_attention_max_distance=self._torch_text_encoder.config.relative_attention_max_distance,
+            layer_norm_eps=tcfg.layer_norm_epsilon,
+            relative_attention_num_buckets=tcfg.relative_attention_num_buckets,
+            relative_attention_max_distance=tcfg.relative_attention_max_distance,
         )
 
         self._tt_encoder = UMT5Encoder(
@@ -89,8 +91,16 @@ class TextEncoder:
             parallel_config=self._encoder_parallel_config,
             mesh_shape=tuple(self._device.shape),
             mesh_device=self._device,
-            get_torch_state_dict=lambda: self._torch_text_encoder.state_dict(),
+            get_torch_state_dict=self._torch_state_dict,
         )
+        self._torch_text_encoder = None
+
+    def _torch_state_dict(self):
+        if self._torch_text_encoder is None:
+            self._torch_text_encoder = UMT5EncoderModel.from_pretrained(
+                self._checkpoint_name, subfolder="text_encoder", trust_remote_code=True
+            )
+        return self._torch_text_encoder.state_dict()
 
     def encode_cfg(
         self,
-- 
