@@ -124,6 +128,23 @@ class WanAttention(Module):
             exp_approx_mode=False,  # NOTE: False is more correct
         )
 
+        # ep4: optional chunk sizes for the non-ring self- and cross-attention SDPA (default = the config above)
+        import os as _os
+
+        def _ep4_cfg(var):
+            v = _os.environ.get(var)
+            if not v:
+                return self.sdpa_program_config
+            q, k = (int(x) for x in v.lower().split("x"))
+            return ttnn.SDPAProgramConfig(
+                compute_with_storage_grid_size=full_grid,
