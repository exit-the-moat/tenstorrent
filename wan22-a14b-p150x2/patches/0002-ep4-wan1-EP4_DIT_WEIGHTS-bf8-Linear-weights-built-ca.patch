 from ....layers.normalization import DistributedLayerNorm
 from ....parallel.config import DiTParallelConfig
@@ -702,6 +702,18 @@ class WanTransformer3DModel(Module):
         return combined
 
 
+def _ep4_weight_dtype():
+    """(ttnn dtype or None, cache key) from EP4_DIT_WEIGHTS (unset/bf16 = stock bf16)."""
+    v = os.environ.get("EP4_DIT_WEIGHTS", "bf16")
+    if v == "bf16":
+        return None, "bf16"
+    if v == "bf8":
+        return ttnn.bfloat8_b, "bf8"
+    if v == "bf4":
+        return ttnn.bfloat4_b, "bf4"
+    raise ValueError(f"EP4_DIT_WEIGHTS={v}")
+
+
 class WanCheckpoint:
     """A Wan transformer-subfolder checkpoint: fetches weights and builds loaded transformers."""
 
@@ -749,6 +761,10 @@ class WanCheckpoint:
         Loading is deferred so the caller can manage the lifecycle (deallocate / reload).
         """
         c = self._config
+        with weight_dtype_override(_ep4_weight_dtype()[0]):
+            return self._build(c, ccl_manager, parallel_config, is_fsdp, model_type, lora_enabled)
+
+    def _build(self, c, ccl_manager, parallel_config, is_fsdp, model_type, lora_enabled):
         return WanTransformer3DModel(
             patch_size=c.patch_size,
             num_heads=c.num_attention_heads,
@@ -781,6 +797,7 @@ class WanCheckpoint:
         cache.load_model(
             tt_model=model,
             get_torch_state_dict=self._load_state_dict,
+            dtype=_ep4_weight_dtype()[1],
             model_name=os.path.basename(self._name),
             subfolder=self._subfolder,
             parallel_config=parallel_config,
