+
+        self.self_sdpa_program_config = _ep4_cfg("EP4_SDPA_CHUNKS")
+        self.cross_sdpa_program_config = _ep4_cfg("EP4_XSDPA_CHUNKS")
         self.sdpa_worker_grid = (full_grid.x - 1, full_grid.y)  # Reserve last column for CCL
         chunk_lookup = {**self.sdpa_chunk_size_map, **(sdpa_chunk_size_overrides or {})}
         ring_sdpa_chunk_size = chunk_lookup.get(
@@ -486,7 +507,7 @@ class WanAttention(Module):
                     k_BHNE,
                     v_BHNE,
                     is_causal=False,
-                    program_config=self.sdpa_program_config,
+                    program_config=self.self_sdpa_program_config,
                     compute_kernel_config=self.sdpa_compute_kernel_config,
                 )
         else:
@@ -497,7 +518,7 @@ class WanAttention(Module):
                 v_BHNE,
