+def core_rect(spec):
+    """"x0,y0,x1,y1" -> CoreRangeSet of that rectangle (None for "")."""
+    if not spec:
+        return None
+    x0, y0, x1, y1 = (int(v) for v in spec.split(","))
+    return ttnn.CoreRangeSet({ttnn.CoreRange(ttnn.CoreCoord(x0, y0), ttnn.CoreCoord(x1, y1))})
 
 
