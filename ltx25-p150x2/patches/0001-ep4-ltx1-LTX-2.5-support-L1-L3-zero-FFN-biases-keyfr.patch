@@ -0,0 +1,306 @@
+# SPDX-FileCopyrightText: © 2025 Tenstorrent AI ULC
+# SPDX-License-Identifier: Apache-2.0
+# Modified by ltx1 (Exit the Moat, Episode 4, 2026-11-18): new file, Gemma 4 "unified" 12B text encoder for LTX-2.5,
+# built from model_gemma.py (Gemma 3). Reference: transformers 5.14.1 models/gemma4_unified/modeling_gemma4_unified.py.
+
+"""TTNN Gemma-4 (unified, 12B) text encoder for LTX-2.5.
+
+Differences to Gemma 3 (model_gemma.py), all per the HF reference:
+- RMSNorm weights are applied as-is (no ``1 + w``); v gets an unscaled RMSNorm.
+- Attention scaling 1.0 (q/k norms carry the scale).
+- Sliding layers: head_dim 256, 8 KV heads, RoPE theta 1e4 (sliding window 1024 >= the 1024-token prompt, so the
+  window never cuts: plain causal).
+- Every 6th layer is global: head_dim 512, ONE KV head, k = v (no v_proj; v is the raw k_proj output, then the
+  unscaled v-norm; k gets k_norm + RoPE), proportional RoPE theta 1e6 with partial rotary 0.25 (the other 3/4 of the
+  frequencies are 0 -> cos 1 / sin 0).
+- Each layer ends with ``hidden *= layer_scalar``.
+- Embedding scale sqrt(3840) rounded to bf16 (= 62.0), like HF.
+The single global KV head is replicated on both TP shards: the fused per-shard [q | k | v] weight carries a copy of
+k_proj as both k and v, so nlp_create_qkv_heads splits it like the sliding layers.
+"""
+
+from __future__ import annotations
+
+import torch
+
+import ttnn
+
+from ...layers.embeddings import Embedding
+from ...layers.linear import ColParallelLinear
+from ...layers.module import Module, ModuleList, Parameter
+from ...layers.normalization import RMSNorm
+from ...parallel.config import EncoderParallelConfig
+from ...parallel.manager import CCLManager
+from ...utils.substate import pop_substate, rename_substate
+from ...utils.tracing import StateTensor
+from .model_gemma import GemmaFF
+
+
+class Gemma4Config:
+    def __init__(
+        self,
+        vocab_size: int = 262144,
+        hidden_size: int = 3840,
+        intermediate_size: int = 15360,
+        num_hidden_layers: int = 48,
+        num_attention_heads: int = 16,
+        num_key_value_heads: int = 8,
+        head_dim: int = 256,
+        global_head_dim: int = 512,
+        num_global_key_value_heads: int = 1,
+        rms_norm_eps: float = 1e-6,
+        rope_theta_global: float = 1000000.0,
+        rope_theta_local: float = 10000.0,
+        partial_rotary_factor_global: float = 0.25,
+        sliding_window_pattern: int = 6,
+        max_position_embeddings: int = 1024,
+        hidden_layer_index: int = -1,
+    ):
+        self.vocab_size = vocab_size
+        self.hidden_size = hidden_size
+        self.intermediate_size = intermediate_size
+        self.num_hidden_layers = num_hidden_layers
+        self.num_attention_heads = num_attention_heads
+        self.num_key_value_heads = num_key_value_heads
+        self.head_dim = head_dim
+        self.global_head_dim = global_head_dim
+        self.num_global_key_value_heads = num_global_key_value_heads
+        self.rms_norm_eps = rms_norm_eps
+        self.rope_theta_global = rope_theta_global
+        self.rope_theta_local = rope_theta_local
+        self.partial_rotary_factor_global = partial_rotary_factor_global
+        self.sliding_window_pattern = sliding_window_pattern
+        self.max_position_embeddings = max_position_embeddings
+        self.hidden_layer_index = hidden_layer_index
+
+    def is_global(self, idx: int) -> bool:
+        return (idx + 1) % self.sliding_window_pattern == 0
+
+
+class Gemma4RMSNorm(RMSNorm):
+    """Gemma 4 RMSNorm: x * rsqrt(mean(x^2) + eps) * w (weight used as-is). affine=False -> no weight (v-norm)."""
+
+    def __init__(self, dim: int, eps: float, mesh_device, affine: bool = True):
+        super().__init__(embedding_dim=dim, norm_eps=eps, norm_elementwise_affine=affine, bias=False,
+                         mesh_device=mesh_device)
+
+
+class Gemma4Rope(Module):
+    """HF-format cos/sin [1,1,seq,head_dim] for rotary_embedding_hf; resident once per seq_len."""
+
+    def __init__(self, head_dim: int, base: float, mesh_device, max_seq: int, partial: float = 1.0):
+        super().__init__()
+        self.mesh_device = mesh_device
+        rope_angles = int(partial * head_dim // 2)
+        inv = 1.0 / (base ** (torch.arange(0, 2 * rope_angles, 2, dtype=torch.int64).float() / head_dim))
+        if head_dim // 2 - rope_angles > 0:
+            inv = torch.cat([inv, torch.zeros(head_dim // 2 - rope_angles)])
+        t = torch.arange(max_seq, dtype=torch.float32)
+        freqs = torch.outer(t, inv)  # fp32 like HF (inv_freq @ positions in fp32)
+        emb = torch.cat([freqs, freqs], dim=-1)
+        self._cos = emb.cos()[None, None]
+        self._sin = emb.sin()[None, None]
+        self._tt_cos = StateTensor()
+        self._tt_sin = StateTensor()
+
+    def forward(self, seq_len: int):
+        if self._tt_cos.value is None:
+            for st, src in ((self._tt_cos, self._cos), (self._tt_sin, self._sin)):
+                st.update(
+                    ttnn.from_torch(src[:, :, :seq_len, :].bfloat16(), device=self.mesh_device,
+                                    layout=ttnn.TILE_LAYOUT, dtype=ttnn.bfloat16),
+                    False,
+                )
+        return self._tt_cos.value, self._tt_sin.value
+
+
+class Gemma4Attention(Module):
+    def __init__(self, config: Gemma4Config, layer_idx: int, mesh_device, ccl_manager: CCLManager,
+                 parallel_config: EncoderParallelConfig):
+        super().__init__()
+        self.config = config
+        self.mesh_device = mesh_device
+        self.ccl_manager = ccl_manager
+        self.parallel_config = parallel_config
+        self.is_global = config.is_global(layer_idx)
+        self.num_heads = config.num_attention_heads
+        self.head_dim = config.global_head_dim if self.is_global else config.head_dim
+        self.num_kv_heads = config.num_global_key_value_heads if self.is_global else config.num_key_value_heads
+        self.hidden_size = config.hidden_size
+        tp = parallel_config.tensor_parallel.factor
+        self.tp = tp
+        self.num_local_heads = self.num_heads // tp
+        # A single global KV head is replicated on every shard.
+        self.kv_replicated = self.num_kv_heads < tp
+        self.num_local_kv_heads = self.num_kv_heads if self.kv_replicated else self.num_kv_heads // tp
+
+        col_kwargs = {"bias": False, "mesh_device": mesh_device, "mesh_axis": parallel_config.tensor_parallel.mesh_axis}
+        qkv_out = tp * (self.num_local_heads + 2 * self.num_local_kv_heads) * self.head_dim
+        self.wqkv = ColParallelLinear(self.hidden_size, qkv_out, **col_kwargs)
+        o_kwargs = dict(col_kwargs)
+        o_kwargs["ccl_manager"] = ccl_manager
+        self.o_proj = ColParallelLinear(self.num_heads * self.head_dim, self.hidden_size, **o_kwargs)
+
+        eps = config.rms_norm_eps
+        self.input_layernorm = Gemma4RMSNorm(self.hidden_size, eps, mesh_device)
+        self.post_attention_layernorm = Gemma4RMSNorm(self.hidden_size, eps, mesh_device)
+        self.q_norm = Gemma4RMSNorm(self.head_dim, eps, mesh_device)
+        self.k_norm = Gemma4RMSNorm(self.head_dim, eps, mesh_device)
+        self.v_norm = Gemma4RMSNorm(self.head_dim, eps, mesh_device, affine=False)
+
+        chunk = 64 if self.head_dim > 256 else 128
+        self.sdpa_config = ttnn.SDPAProgramConfig(
+            compute_with_storage_grid_size=mesh_device.compute_with_storage_grid_size(),
+            q_chunk_size=chunk,
+            k_chunk_size=chunk,
+            exp_approx_mode=False,
+        )
+        self.compute_config = ttnn.init_device_compute_kernel_config(
+            mesh_device.arch(), math_fidelity=ttnn.MathFidelity.HiFi2, math_approx_mode=False,
+            fp32_dest_acc_en=True, packer_l1_acc=True,
+        )
+
+    def _prepare_torch_state(self, state: dict[str, torch.Tensor]) -> None:
+        q = pop_substate(state, "q_proj")["weight"]
+        k = pop_substate(state, "k_proj")["weight"]
+        vs = pop_substate(state, "v_proj")
+        v = vs["weight"] if "weight" in vs else k  # global layers: k = v (raw k_proj output)
+        tp, d, H = self.tp, self.head_dim, self.hidden_size
+        qh = q.T.reshape(H, tp, self.num_local_heads, d)
+        if self.kv_replicated:
+            kh = k.T.reshape(H, 1, self.num_kv_heads, d).expand(H, tp, self.num_kv_heads, d)
+            vh = v.T.reshape(H, 1, self.num_kv_heads, d).expand(H, tp, self.num_kv_heads, d)
+        else:
+            kh = k.T.reshape(H, tp, self.num_local_kv_heads, d)
+            vh = v.T.reshape(H, tp, self.num_local_kv_heads, d)
+        qkv = torch.cat([qh, kh, vh], dim=2)
+        state["wqkv.weight"] = qkv.reshape(H, -1).T.contiguous()
+
+    def forward(self, hidden_states, cos, sin, attn_mask=None):
+        residual = hidden_states
+        x = self.input_layernorm(hidden_states)
+        qkv = self.wqkv(x, compute_kernel_config=self.compute_config)
+        qkv = ttnn.reshape(qkv, (qkv.shape[0], 1, qkv.shape[1], qkv.shape[2]))
+        q, k, v = ttnn.experimental.nlp_create_qkv_heads(
+            qkv, num_heads=self.num_local_heads, num_kv_heads=self.num_local_kv_heads, transpose_k_heads=False,
+            memory_config=ttnn.DRAM_MEMORY_CONFIG,
+        )
+        q = self.q_norm(q)
+        k = self.k_norm(k)
+        v = self.v_norm(v)
+        q = ttnn.experimental.rotary_embedding_hf(q, cos, sin, is_decode_mode=False)
+        k = ttnn.experimental.rotary_embedding_hf(k, cos, sin, is_decode_mode=False)
+        if self.num_local_kv_heads < self.num_local_heads:
+            rep = self.num_local_heads // self.num_local_kv_heads
+            k = ttnn.repeat_interleave(k, rep, dim=1)
+            v = ttnn.repeat_interleave(v, rep, dim=1)
+        q = ttnn.to_memory_config(q, ttnn.DRAM_MEMORY_CONFIG)
+        k = ttnn.to_memory_config(k, ttnn.DRAM_MEMORY_CONFIG)
+        v = ttnn.to_memory_config(v, ttnn.DRAM_MEMORY_CONFIG)
+        attn = ttnn.transformer.scaled_dot_product_attention(
+            q, k, v, is_causal=(attn_mask is None), attn_mask=attn_mask, scale=1.0,
+            program_config=self.sdpa_config, compute_kernel_config=self.compute_config,
+        )
+        attn = ttnn.transformer.concatenate_heads(attn)
+        attn = ttnn.unsqueeze(attn, 0)
+        if self.tp > 1:
+            attn = self.ccl_manager.all_gather(attn, dim=3, mesh_axis=self.parallel_config.tensor_parallel.mesh_axis,
+                                               use_hyperparams=True)
+        out = self.o_proj(attn, compute_kernel_config=self.compute_config)
+        if self.tp > 1:
+            out = self.ccl_manager.all_gather(out, dim=3, mesh_axis=self.parallel_config.tensor_parallel.mesh_axis,
+                                              use_hyperparams=True)
+        out = ttnn.squeeze(out, 0)
+        out = self.post_attention_layernorm(out)
+        return out + residual
+
+
+class _Gemma4FF(GemmaFF):
+    """Gemma 3 FF block with Gemma 4 norms (weights as-is)."""
+
+    def __init__(self, config, mesh_device, ccl_manager, parallel_config):
+        super().__init__(config, mesh_device, ccl_manager, parallel_config)
+        self.pre_feedforward_layernorm = Gemma4RMSNorm(config.hidden_size, config.rms_norm_eps, mesh_device)
+        self.post_feedforward_layernorm = Gemma4RMSNorm(config.hidden_size, config.rms_norm_eps, mesh_device)
+
+
+class Gemma4EncoderLayer(Module):
+    def __init__(self, config, layer_idx, mesh_device, ccl_manager, parallel_config):
+        super().__init__()
+        self.self_attn = Gemma4Attention(config, layer_idx, mesh_device, ccl_manager, parallel_config)
+        self.ff = _Gemma4FF(config, mesh_device, ccl_manager, parallel_config)
+        self.layer_scalar = Parameter(total_shape=[1, 1], device=mesh_device, dtype=ttnn.bfloat16)
+
+    def _prepare_torch_state(self, state):
+        rename_substate(state, "input_layernorm", "self_attn.input_layernorm")
+        rename_substate(state, "post_attention_layernorm", "self_attn.post_attention_layernorm")
+        rename_substate(state, "pre_feedforward_layernorm", "ff.pre_feedforward_layernorm")
+        rename_substate(state, "post_feedforward_layernorm", "ff.post_feedforward_layernorm")
+        rename_substate(state, "mlp.gate_proj", "ff.gate_proj")
+        rename_substate(state, "mlp.up_proj", "ff.up_proj")
+        rename_substate(state, "mlp.down_proj", "ff.down_proj")
+        if "layer_scalar" in state:
+            state["layer_scalar"] = state["layer_scalar"].reshape(1, 1)
+
+    def forward(self, hidden_states, cos, sin, attn_mask=None):
+        h = self.self_attn(hidden_states, cos, sin, attn_mask=attn_mask)
+        h = self.ff(h)
+        return ttnn.multiply(h, self.layer_scalar.data)
+
+
+class Gemma4Encoder(Module):
+    """Embed -> 48 layers -> final norm. Returns [embed, L0..L47, final_norm] (like GemmaEncoder)."""
+
+    def __init__(self, config: Gemma4Config, mesh_device, ccl_manager: CCLManager,
+                 parallel_config: EncoderParallelConfig):
+        super().__init__()
+        self.config = config
+        self.mesh_device = mesh_device
+        self.embed_tokens = Embedding(config.vocab_size, config.hidden_size, device=mesh_device)
+        self.rope_global = Gemma4Rope(config.global_head_dim, config.rope_theta_global, mesh_device,
+                                      config.max_position_embeddings, partial=config.partial_rotary_factor_global)
+        self.rope_local = Gemma4Rope(config.head_dim, config.rope_theta_local, mesh_device,
+                                     config.max_position_embeddings)
+        self.layers = ModuleList(
+            Gemma4EncoderLayer(config, i, mesh_device, ccl_manager, parallel_config)
+            for i in range(config.num_hidden_layers)
+        )
+        self.norm = Gemma4RMSNorm(config.hidden_size, config.rms_norm_eps, mesh_device)
+        # HF: embed_scale = hidden_size**0.5 cast to the weight dtype (bf16) -> 62.0
+        self.embed_scale = float(torch.tensor(config.hidden_size**0.5).to(torch.bfloat16))
+
+    def _prepare_torch_state(self, state: dict[str, torch.Tensor]) -> None:
+        prefix = "model."
+        for k in list(state.keys()):
+            if k.startswith(prefix):
+                state[k[len(prefix):]] = state.pop(k)
+        for p in ("audio_projector", "multi_modal_projector", "text_embedding_projection", "vision_model",
+                  "lm_head"):
+            pop_substate(state, p)
+        for k in [k for k in state if k.startswith(("hf_asset__", "tokenizer_json"))]:
+            del state[k]
+
+    build_attn_mask = None  # set below (shared with Gemma 3)
+
+    def forward(self, token_ids: ttnn.Tensor, *, tt_attn_mask: ttnn.Tensor | None = None) -> list[ttnn.Tensor]:
+        h = self.embed_tokens(token_ids)
+        h = ttnn.multiply(h, self.embed_scale)
+        seq_len = token_ids.shape[-1]
+        cg, sg = self.rope_global(seq_len)
+        cl, sl = self.rope_local(seq_len)
+        outs = [h]
+        for idx, layer in enumerate(self.layers):
+            c, s = (cg, sg) if self.config.is_global(idx) else (cl, sl)
+            h = layer(h, c, s, attn_mask=tt_attn_mask)
+            outs.append(h)
+        outs.append(self.norm(h))
+        return outs
+
+
+def _bind_mask_builder():
+    from .model_gemma import GemmaEncoder
+
+    Gemma4Encoder.build_attn_mask = GemmaEncoder.build_attn_mask
