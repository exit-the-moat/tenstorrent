+def _is_gemma4_file(path: str | None) -> bool:
+    """ltx1: LTX-2.5 single-file Gemma 4 text encoder (metadata gemma_config.model_type == gemma4_unified)."""
+    if not path or not os.path.isfile(path):
+        return False
+    import json as _json
+
+    with open(path, "rb") as f:
+        n = int.from_bytes(f.read(8), "little")
+        meta = _json.loads(f.read(n)).get("__metadata__", {}) or {}
+    try:
+        return _json.loads(meta.get("gemma_config", "{}")).get("model_type") == "gemma4_unified"
+    except Exception:  # noqa: BLE001
+        return False
+
