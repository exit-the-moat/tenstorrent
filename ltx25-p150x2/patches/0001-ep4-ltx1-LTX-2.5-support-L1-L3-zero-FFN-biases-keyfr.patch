+class _Gemma4LTXTokenizer:
+    """ltx1: ltx_core LTXGemmaTokenizer semantics on the tokenizer embedded in the LTX-2.5 TE file."""
+
+    def __init__(self, path: str, bos_id: int = 2, pad_id: int = 0):
+        from tokenizers import Tokenizer
+
+        with safe_open(path, "pt") as f:
+            raw = f.get_tensor("tokenizer_json").numpy().tobytes().decode("utf-8")
+        self.tok = Tokenizer.from_str(raw)
+        self.tok.no_padding()
+        self.tok.no_truncation()
+        self.bos_id, self.pad_id = bos_id, pad_id
+
+    def __call__(self, prompt, return_tensors="pt", padding="max_length", max_length=1024, truncation=True):
+        from types import SimpleNamespace
+
+        ids = self.tok.encode(prompt.strip(), add_special_tokens=True).ids[:max_length]
+        if not ids or ids[0] != self.bos_id:
+            ids = [self.bos_id, *ids][:max_length]
+        pad = max_length - len(ids)
+        return SimpleNamespace(
+            input_ids=torch.tensor([[self.pad_id] * pad + ids], dtype=torch.int64),
+            attention_mask=torch.tensor([[0] * pad + [1] * len(ids)], dtype=torch.int64),
+        )
 
