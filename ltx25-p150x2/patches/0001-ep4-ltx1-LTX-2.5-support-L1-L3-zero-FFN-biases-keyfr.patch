+def _ltx_ancestral_coeffs(sigma: float, sigma_next: float, eta: float = 1.0):
+    """EulerAncestralDiffusionStep (ltx_core, rectified flow): x_next = A*x + Bc*x0 + c*noise."""
+    s = torch.tensor(sigma, dtype=torch.float32)
+    sn = torch.tensor(sigma_next, dtype=torch.float32)
+    sd = sn * (1.0 + (sn / s - 1.0) * eta)
+    r = sd / s
+    an, ad = 1.0 - sn, 1.0 - sd
+    c = (sn**2 - sd**2 * an**2 / ad**2).clamp(min=0) ** 0.5
+    k = an / ad
+    return float(k * r), float(k * (1.0 - r)), float(c)
