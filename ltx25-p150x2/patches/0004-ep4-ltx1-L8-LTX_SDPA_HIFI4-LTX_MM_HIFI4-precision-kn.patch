From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Exit the Moat <no-reply@exit-the-moat.com>
Date: Thu, 19 Nov 2026 01:21:20 +0100
Subject: [PATCH] ep4 (ltx1): L8 LTX_SDPA_HIFI4 / LTX_MM_HIFI4 precision knobs
 (no PCC change, default off); L9 LTX_CONV3D_BORROW=1: borrow the swept
 LTX-2.3 2x4/4x8 conv3d blockings for our 1x2 mesh (every VAE/upsampler conv
 used 1x1x1-block fallbacks). 720p VAE decode 28.9 -> 2.87 s (output PCC vs
 fallback 0.99997); counted clips (idle host): 480p 23.9/24.1 -> 12.55/12.7 s,
 720p 49.8/50.1 -> 22.0/22.05 s (-56 %), 1080p 134.0/134.4 -> 57.3/57.5 s.
 T_out_block clamped to the layer T (a 25-frame test hung the card with the
 unclamped table; reset by main)

---
 .../models/transformers/ltx/attention_ltx.py  | 10 ++++----
 models/tt_dit/utils/conv3d.py                 | 23 +++++++++++++++++++
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/models/tt_dit/models/transformers/ltx/attention_ltx.py b/models/tt_dit/models/transformers/ltx/attention_ltx.py
index 99cb53b8822c..3734cd5c16f3 100644
--- a/models/tt_dit/models/transformers/ltx/attention_ltx.py
+++ b/models/tt_dit/models/transformers/ltx/attention_ltx.py
@@ -213,11 +213,12 @@ class LTXAttention(Module):
         )
 
         # All SDPA (ring + cross) runs HiFi2, matching the Wan attention config.
+        _hi = os.environ.get("LTX_SDPA_HIFI4", "0") == "1"  # ltx1 L8
         self.sdpa_compute_kernel_config = ttnn.init_device_compute_kernel_config(
             self.mesh_device.arch(),
-            math_fidelity=ttnn.MathFidelity.HiFi2,
+            math_fidelity=ttnn.MathFidelity.HiFi4 if _hi else ttnn.MathFidelity.HiFi2,
             math_approx_mode=False,
-            fp32_dest_acc_en=False,
+            fp32_dest_acc_en=_hi,
         )
 
         self.rope_compute_kernel_config = ttnn.init_device_compute_kernel_config(
@@ -232,10 +233,11 @@ class LTXAttention(Module):
         self.core_grid = ttnn.CoreGrid(x=device_grid.x, y=device_grid.y)
 
         # Attention QKV/out matmuls run HiFi2, matching the Wan attention config.
+        _mhi = os.environ.get("LTX_MM_HIFI4", "0") == "1"  # ltx1 L8
         self.mm_compute_kernel_config = ttnn.init_device_compute_kernel_config(
             self.mesh_device.arch(),
-            math_fidelity=ttnn.MathFidelity.HiFi2,
-            math_approx_mode=True,
+            math_fidelity=ttnn.MathFidelity.HiFi4 if _mhi else ttnn.MathFidelity.HiFi2,
+            math_approx_mode=not _mhi,
             fp32_dest_acc_en=True,
             packer_l1_acc=True,
         )
diff --git a/models/tt_dit/utils/conv3d.py b/models/tt_dit/utils/conv3d.py
index a3b1c7254583..813754b08f24 100644
--- a/models/tt_dit/utils/conv3d.py
+++ b/models/tt_dit/utils/conv3d.py
@@ -5,6 +5,7 @@
 import collections
 import hashlib
 import math
+import os
 from itertools import repeat
 from typing import NamedTuple
 
@@ -556,6 +557,22 @@ _FP32_BLOCKINGS: dict = {
 }
 
 
+# ltx1 L9: LTX-2.3 swept 2x4 / 4x8 BH blockings, keyed by channels + kernel only (for other meshes/shapes).
+_LTX_BORROW = {
+    (128, 1024, (3, 3, 3)): (64, 256, 1, 2, 16),
+    (1024, 1024, (3, 3, 3)): (128, 64, 5, 2, 16),
+    (1024, 4096, (3, 3, 3)): (128, 64, 5, 4, 8),
+    (512, 512, (3, 3, 3)): (64, 256, 1, 8, 4),
+    (512, 4096, (3, 3, 3)): (128, 64, 5, 2, 16),
+    (256, 256, (3, 3, 3)): (64, 256, 1, 8, 4),
+    (256, 512, (3, 3, 3)): (64, 256, 1, 8, 4),
+    (128, 128, (3, 3, 3)): (64, 128, 6, 4, 8),
+    (128, 48, (3, 3, 3)): (128, 64, 6, 4, 8),
+    (1024, 4096, (1, 3, 3)): (256, 64, 1, 4, 4),
+    (1024, 128, (3, 3, 3)): (128, 64, 7, 8, 4),
+}
+
+
 def register_conv3d_configs(configs: dict) -> None:
     """Register additional conv3d blocking configs from external models.
 
@@ -607,6 +624,12 @@ def get_conv3d_config(
     channel_key = (in_channels, out_channels, kernel_size)
 
     exact = _BLOCKINGS.get(blocking_key)
+    if exact is None and os.environ.get("LTX_CONV3D_BORROW", "0") == "1":  # ltx1 L9
+        exact = _LTX_BORROW.get(channel_key)
+        if exact is not None and (T <= 0 or exact[2] > max(1, T - 2)):
+            # short clips (e.g. 25 frames): a T_out_block larger than T_out hung the card (aux2, 19 Nov): use it
+            # only when the layer's T is known and >= block + kernel pad
+            exact = None if T <= 0 else (exact[0], exact[1], max(1, min(exact[2], T - 2)), exact[3], exact[4])
     if exact is not None:
         C_in_block, C_out_block, T_out_block, H_out_block, W_out_block = exact
         logger.debug(
-- 
2.54.0

