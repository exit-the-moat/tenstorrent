     def _modulated_ffn(self, ffn, norm, x_1BND, shift_ff, scale_ff_p1, gate_ff):
+        """ltx1 M6 wrapper: optional sequence chunking (LTX_FFN_CHUNK)."""
+        n = x_1BND.shape[2]
+        c = int(os.environ.get("LTX_FFN_CHUNK", "0"))
+        if c <= 0 or n <= c:
+            return self._modulated_ffn_full(ffn, norm, x_1BND, shift_ff, scale_ff_p1, gate_ff)
+        c = max(32, c // 32 * 32)
+        outs = []
+        for i in range(0, n, c):
+            e = min(i + c, n)
+            sl = lambda t: t[:, :, i:e, :] if (t.shape[2] == n and n > 1) else t
+            xi = sl(x_1BND)
+            outs.append(self._modulated_ffn_full(ffn, norm, xi, sl(shift_ff), sl(scale_ff_p1), sl(gate_ff)))
+            ttnn.deallocate(xi)
+        out = ttnn.concat(outs, dim=2)
+        for o in outs:
+            ttnn.deallocate(o)
+        return out
+
