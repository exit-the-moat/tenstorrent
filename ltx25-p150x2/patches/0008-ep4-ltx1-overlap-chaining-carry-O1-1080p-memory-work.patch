+def _ltx_free_ccl(pipe, tag):
+    """ltx1 M5."""
+    if os.environ.get("LTX_CCL_FREE") != "1" or getattr(pipe, "_traced", False):
+        return
+    import ttnn as _ttnn
+    _ttnn.synchronize_device(pipe.mesh_device)
+    seen = set()
+    for m in (getattr(pipe, "ccl_manager", None), getattr(pipe, "vae_ccl_manager", None)):
+        if m is None or id(m) in seen:
+            continue
+        seen.add(id(m))
+        def _free(x):
+            if isinstance(x, (list, tuple)):
+                for y in x:
+                    _free(y)
+            elif isinstance(x, dict):
+                for y in x.values():
+                    _free(y)
+            elif x is not None and hasattr(x, "is_allocated"):
+                try:
+                    if x.is_allocated():
+                        _ttnn.deallocate(x)
+                except Exception:  # noqa: BLE001
+                    pass
+        _free(m._ping_pong_buffer_cache); m._ping_pong_buffer_cache.clear(); m._ping_pong_buffer_indices.clear()
+        _free(m._fused_norm_stats_buffer_cache); m._fused_norm_stats_buffer_cache.clear()
+    _ltx_memlog(pipe.mesh_device, f"ccl_freed:{tag}")
+
