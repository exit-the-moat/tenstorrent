+++ b/models/tt_dit/layers/linear.py
@@ -2,6 +2,8 @@
 
 # SPDX-License-Identifier: Apache-2.0
 
+import contextlib
+import contextvars
 import math
 
 import torch
@@ -18,6 +20,28 @@ MATH_FIDELITY = {
     ttnn.float32: ttnn.MathFidelity.HiFi4,
 }
 
+# Optional weight format override for big layers (ep3), opt-in via weight_dtype_override(); default off.
+_WEIGHT_DTYPE_OVERRIDE = contextvars.ContextVar("tt_dit_weight_dtype", default=None)
+_WEIGHT_OVERRIDE_MIN_ELEMENTS = 1 << 20
+
+
+@contextlib.contextmanager
+def weight_dtype_override(dtype):
+    """While active, Linear-style weights of at least 2**20 elements are created with `dtype` (bias stays bf16)."""
+    token = _WEIGHT_DTYPE_OVERRIDE.set(dtype)
+    try:
+        yield
+    finally:
+        _WEIGHT_DTYPE_OVERRIDE.reset(token)
+
+
+def _resolve_weight_dtype(dtype, in_features, out_features):
+    override = _WEIGHT_DTYPE_OVERRIDE.get()
+    if override is None or dtype != ttnn.bfloat16 or in_features * out_features < _WEIGHT_OVERRIDE_MIN_ELEMENTS:
+        return dtype
+    return override
+
+
 # Activation strings accepted by Linear / ColParallelLinear `activation_fn`,
 # mapped to the values the matmul fused-activation path expects. Each value is
 # either a bare ttnn.UnaryOpType (no parameter) or a (UnaryOpType, param0)
@@ -76,7 +100,11 @@ class Linear(Module):
             packer_l1_acc=True,
         )
 
-        self.weight = Parameter(total_shape=[self.in_features, self.out_features], device=mesh_device, dtype=dtype)
+        self.weight = Parameter(
+            total_shape=[self.in_features, self.out_features],
+            device=mesh_device,
+            dtype=_resolve_weight_dtype(dtype, self.in_features, self.out_features),
+        )
         self.bias = Parameter(total_shape=[1, self.out_features], device=mesh_device, dtype=dtype) if bias else None
 
     def _prepare_torch_state(self, state: dict[str, torch.Tensor]) -> None:
@@ -179,7 +207,7 @@ class ColParallelLinear(Module):
             total_shape=[self.in_features, self.out_features],
             mesh_axes=[fsdp_mesh_axis, mesh_axis],
             device=mesh_device,
-            dtype=dtype,
+            dtype=_resolve_weight_dtype(dtype, self.in_features, self.out_features),
         )
         self.bias = (
             Parameter(total_shape=[1, self.out_features], mesh_axes=[None, mesh_axis], device=mesh_device, dtype=dtype)
@@ -349,7 +377,7 @@ class RowParallelLinear(Module):
             total_shape=[self.in_features, self.out_features],
             mesh_axes=[mesh_axis, fsdp_mesh_axis],
             device=mesh_device,
-            dtype=dtype,
+            dtype=_resolve_weight_dtype(dtype, self.in_features, self.out_features),
         )
         self.bias = (
             Parameter(
