         return self._inner.combine(predictions, cfg_scale)
 
 
+def _norm_rescale(combined: ttnn.Tensor, cond: ttnn.Tensor) -> ttnn.Tensor:
+    """ep3: per-token rescale as in diffusers' QwenImagePipeline: comb * (norm(cond, -1) / norm(comb, -1))."""
+    ck = ttnn.init_device_compute_kernel_config(
+        combined.device().arch(), math_fidelity=ttnn.MathFidelity.HiFi4, math_approx_mode=False, fp32_dest_acc_en=True
+    )
+    cond_sq = ttnn.sum(ttnn.multiply(cond, cond), dim=-1, keepdim=True, compute_kernel_config=ck)
+    comb_sq = ttnn.sum(ttnn.multiply(combined, combined), dim=-1, keepdim=True, compute_kernel_config=ck)
+    return ttnn.multiply(combined, ttnn.sqrt(ttnn.divide(cond_sq, comb_sq)))
+
+
 class _SingleCombiner:
+    def __init__(self, *, rescale: bool = False) -> None:
+        self._rescale = rescale
+
     def combine(self, predictions: Sequence[ttnn.Tensor], cfg_scale: float) -> tuple[ttnn.Tensor]:
+        if len(predictions) == 2:  # ep3: separate forward per branch (real-length prompts)
+            uncond, cond = predictions
+            combined = ttnn.lerp(uncond, cond, cfg_scale)
+            return (_norm_rescale(combined, cond) if self._rescale else combined,)
+
         if len(predictions) != 1:
             msg = f"expected 1 prediction tensor for single-device combiner, got {len(predictions)}"
             raise ValueError(msg)
@@ -65,13 +85,14 @@ class _SingleCombiner:
         cond = prediction[split_pos:]
         combined = ttnn.lerp(uncond, cond, cfg_scale)
 
-        return (combined,)
+        return (_norm_rescale(combined, cond) if self._rescale else combined,)
 
 
 class _HostCombiner:
-    def __init__(self, uncond_device: ttnn.MeshDevice, cond_device: ttnn.MeshDevice) -> None:
+    def __init__(self, uncond_device: ttnn.MeshDevice, cond_device: ttnn.MeshDevice, *, rescale: bool = False) -> None:
         self._uncond_device = uncond_device
         self._cond_device = cond_device
+        self._rescale = rescale
 
     def combine(self, predictions: Sequence[ttnn.Tensor], cfg_scale: float) -> tuple[ttnn.Tensor, ttnn.Tensor]:
         if len(predictions) != 2:
@@ -92,6 +113,10 @@ class _HostCombiner:
         combined0 = ttnn.lerp(uncond, received_cond, cfg_scale)
         combined1 = ttnn.lerp(received_uncond, cond, cfg_scale)
 
+        if self._rescale:
+            combined0 = _norm_rescale(combined0, received_cond)
+            combined1 = _norm_rescale(combined1, cond)
+
         return combined0, combined1
 
 
