diff --git a/models/tt_dit/utils/matmul.py b/models/tt_dit/utils/matmul.py
index 65c950626..e2620114c 100644
--- a/models/tt_dit/utils/matmul.py
+++ b/models/tt_dit/utils/matmul.py
@@ -186,6 +186,21 @@ grid_12_9_configs = {
 }
 
 
+_EP3_MM = None
+
+
+def _ep3_mm_override():
+    """img3: blockings from EP3_MM_OVERRIDE ("GXxGY:M,K,N:mb,kb,nb,sh,sw;..."), parsed once; empty = none."""
+    global _EP3_MM
+    if _EP3_MM is None:
+        _EP3_MM = {}
+        for e in filter(None, __import__("os").environ.get("EP3_MM_OVERRIDE", "").split(";")):
+            g, shp, blk = e.split(":")
+            gx, gy = [int(v) for v in g.split("x")]
+            _EP3_MM[(gx, gy, *[int(v) for v in shp.split(",")])] = tuple(int(v) for v in blk.split(","))
+    return _EP3_MM
+
+
 def get_matmul_config(M, K, N, core_grid, default_block_size=None):
     # Default to 8x8x8 with subblock 2x2 when unknown
     subblock_h = 2
@@ -198,6 +213,10 @@ def get_matmul_config(M, K, N, core_grid, default_block_size=None):
     config_tuple = None
     grid_x = getattr(core_grid, "x", None)
     grid_y = getattr(core_grid, "y", None)
+    _ov = _ep3_mm_override().get((grid_x, grid_y, M, K, N))
+    if _ov is not None:
+        return ttnn.MinimalMatmulConfig(M_block_size=_ov[0], K_block_size=_ov[1], N_block_size=_ov[2], subblock_h=_ov[3],
+                                        subblock_w=_ov[4], compute_with_storage_grid_size=core_grid)
     grid_lookup = {
         (8, 8): grid_88_configs,
         (8, 9): grid_89_configs,
