-        n = norm(x4, dynamic_weight=(1 + scale), dynamic_bias=shift)
+    def _ep3_plain_sdpa(self, at, q, k, v, aq, ak, av):
+        """img3: plain streaming SDPA over [spatial ; prompt] (rear), split after concatenate_heads."""
+        B, H, N, D = q.shape[0], q.shape[1], q.shape[2], q.shape[3]
+        L, Lp = aq.shape[2], aq.padded_shape[2]
+        assert N % 32 == 0, "spatial length must be tile aligned"
+        pc = getattr(at, "ep3_psdpa_pc", None)
+        if pc is None:
+            g = self.mesh_device.compute_with_storage_grid_size()
+            qc, kc = [int(x) for x in __import__("os").environ.get("EP3_PSDPA_CHUNKS", "256x512").split("x")]
+            pc = at.ep3_psdpa_pc = ttnn.SDPAProgramConfig(compute_with_storage_grid_size=(g.x, g.y), q_chunk_size=qc,
+                                                           k_chunk_size=kc, exp_approx_mode=False)
+
+        def cat(x, y):
+            if L != Lp:
+                y = ttnn.reshape(y, ttnn.Shape([B, H, Lp, D]), ttnn.Shape([B, H, Lp, D]))
+            c = ttnn.concat([x, y], dim=2)
+            return ttnn.reshape(c, ttnn.Shape([B, H, N + L, D]), ttnn.Shape([B, H, N + Lp, D])) if L != Lp else c
+
+        Q, K, V = cat(q, aq), cat(k, ak), cat(v, av)
+        o = ttnn.transformer.scaled_dot_product_attention(Q, K, V, is_causal=False, program_config=pc,
+                                                          compute_kernel_config=at.sdpa_compute_kernel_config)
+        ttnn.deallocate(Q); ttnn.deallocate(K); ttnn.deallocate(V)
+        oc = ttnn.transformer.concatenate_heads(o)
+        ttnn.deallocate(o)
+        HD = oc.shape[-1]
+        s_att = ttnn.slice(oc, [0, 0, 0], [B, N, HD])
+        p_att = ttnn.slice(oc, [0, N, 0], [B, N + L, HD])
+        ttnn.deallocate(oc)
+        return ttnn.unsqueeze(s_att, 0), ttnn.unsqueeze(p_att, 0)
+
+    def _ep3_ff(self, F, ff, norm, x4, scale, shift, gate, w=None):
+        n = norm(x4, dynamic_weight=(w if w is not None else (1 + scale)), dynamic_bias=shift)
         h = self._ep3_agmm(ff.ff1, n) if "ff1" in F else ff.ff1(self._ep3_ag(n))
         return self._ep3_gated(F, x4, ff.ff2(h), ttnn.unsqueeze(gate, 0))
 
@@ -357,6 +409,9 @@ class QwenImageTransformer(Module):
         return spatial.permute(0, 1, 4, 2, 5, 3).flatten(3, 4).flatten(1, 2)
 
 
+_EP3_TKEY = None  # img3: modulation cache key (float timestep), set by the pipeline when EP3_MODCACHE is set
+
+
 def _chunk_time3d(t: ttnn.Tensor, count: int) -> list[ttnn.Tensor]:
     size = t.shape[-1] // count
     return [t[:, :, i * size : (i + 1) * size] for i in range(count)]
