@@ -146,11 +165,14 @@ class QwenImageTransformerBlock(TransformerBlock):
         if __import__("os").environ.get("EP3_DUMP_QKV") and getattr(self, "_ep3_idx", -1) == int(__import__("os").environ.get("EP3_DUMP_BLOCK", "30")):
             _g = lambda t: ttnn.to_torch(ttnn.get_device_tensors(t)[0]).float()
             torch.save(dict(q=_g(q), k=_g(k), v=_g(v), jq=_g(aq), jk=_g(ak), jv=_g(av)), __import__("os").environ["EP3_DUMP_QKV"])
